# Modelo do Back-end/.env. Copie para Back-end/.env e preencha.
# O Back-end/.env está no .gitignore: as senhas reais NUNCA vão para o GitHub.

# Banco (o docker-compose.yml já define estes valores para o container)
DB_HOST=database
DB_USER=dev_user
DB_PASSWORD=devpassword
DB_NAME=wagegap_db
DB_PORT=3306

# E-mail. Sem SMTP_HOST, os e-mails só aparecem no log da API.
# Gmail: use uma "senha de app" (https://myaccount.google.com/apppasswords),
# não a senha normal da conta. Escreva os 16 caracteres sem espaços.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM=WageGap AI <seu-email@gmail.com>

# Endereço do site, usado no link de recuperação de senha
FRONTEND_URL=http://localhost:8080
